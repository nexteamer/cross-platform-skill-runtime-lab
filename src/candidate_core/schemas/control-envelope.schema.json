{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nexteamer/cross-platform-skill-runtime-lab/schemas/control-envelope.schema.json",
  "title": "Control Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_version",
    "run_id",
    "command",
    "status",
    "error",
    "stages",
    "observations",
    "evidence",
    "ownership"
  ],
  "properties": {
    "envelope_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "blocked", "partial_success"]
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "message"],
          "properties": {
            "category": { "type": "string", "minLength": 1 },
            "message": { "type": "string" }
          }
        }
      ]
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "observations", "evidence", "error"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "skipped", "blocked"]
          },
          "observations": { "type": "object" },
          "evidence": {
            "type": "array",
            "items": { "$ref": "#/$defs/evidence_ref" }
          },
          "error": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["category", "message"],
                "properties": {
                  "category": { "type": "string", "minLength": 1 },
                  "message": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },
    "observations": { "type": "object" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_ref" }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "mutations"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "mutations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
